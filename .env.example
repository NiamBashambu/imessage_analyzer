# macOS Messages database
DB_PATH=~/Library/Messages/chat.db

# Generated HTML site
OUTPUT_DIR=./output

# How you appear on the leaderboard (your sent messages)
YOUR_NAME=You

# IANA timezone for dates and the "When" chart
# Examples: America/New_York, America/Chicago, America/Denver, America/Los_Angeles
TIMEZONE=America/Los_Angeles

# Optional phone/email → name overrides (copy aliases.example.json → aliases.json)
ALIASES_FILE=./aliases.json

# Chats for CLI batch runs only (optional if you use `python app.py`)
# Run `python analyze.py --list` to see groups and 1:1s
# Examples: Family Group,Roommates,Sam
TARGET_GROUP_CHATS=Family Group,Roommates
# TARGET_CHATS=Family Group,Sam   # optional alias for the same setting

# Optional: words/phrases to rank on the Keywords page (comma-separated)
# Leave blank to skip that page. Override in the app Options or with --keywords
KEYWORDS=lol,lmao,omg,fr,ngl,bet,bruh,idk

# Optional date filter for CLI (timezone from TIMEZONE). Use YEAR alone, or SINCE/UNTIL.
# In the app, set these under Options instead.
# YEAR=2025
# SINCE=2024-06-01
# UNTIL=2025-12-31

# Exports written under output/ (csv, json, csv,json, or none)
EXPORT=csv,json

# Local web app (python app.py)
# PORT=5050
